# Browser-facing API base URL. Use /backend on Vercel to avoid mixed-content
# while the cPanel API does not have valid HTTPS.
NEXT_PUBLIC_API_URL=/backend

# Server-side API origin used by the Next.js rewrite.
API_ORIGIN_URL=http://api-kmd.kimmex.com.kh/api

# Public storefront URL used by metadata and sitemap.
NEXT_PUBLIC_SITE_URL=https://kmdecor.com
